# ─────────────────────────────────────────────────────────
# AI Code Generator — Environment Variables
#
# 1. Copy this file:   cp .env.example .env
# 2. Fill in your values below
# 3. NEVER commit .env to version control
# ─────────────────────────────────────────────────────────

# ── HuggingFace Settings ──────────────────────────────────

# (Optional) Your HuggingFace API token.
# Required ONLY if you use a gated model (e.g. CodeLlama) or the
# free Inference API endpoint.  Create one at https://huggingface.co/settings/tokens
HUGGINGFACE_API_TOKEN=hf_your_token_here

# ── Model Selection ───────────────────────────────────────

# Name of the HuggingFace model to use for code generation.
# Recommended free/open models:
#   "bigcode/starcoder2-3b"          — fast, great quality, 3B params
#   "Salesforce/codegen-350M-mono"   — very lightweight (~350M), CPU-friendly
#   "microsoft/phi-2"                — 2.7B, general purpose + code
#   "meta-llama/CodeLlama-7b-hf"     — needs HF token (gated)
# Lightweight (default, CPU-friendly)
MODEL_NAME=Salesforce/codegen-350M-mono

# Better quality (~6 GB RAM)
MODEL_NAME=bigcode/starcoder2-3b

# Best quality (needs GPU + HF token)
MODEL_NAME=meta-llama/CodeLlama-7b-hf


# ── Generation Hyper-parameters ──────────────────────────

# Maximum new tokens to generate
MAX_NEW_TOKENS=300

# Sampling temperature (0 = greedy, 1 = creative)
TEMPERATURE=0.2

# Top-p nucleus sampling
TOP_P=0.95

# Repetition penalty — helps avoid looping output
REPETITION_PENALTY=1.1

# ── App Settings ──────────────────────────────────────────

# Use local model ("local") or HuggingFace Inference API ("api")
INFERENCE_MODE=local

# Optional: Force CPU even if a GPU is available (true/false)
FORCE_CPU=false
